# URL de conexion a MySQL, usada por el adapter de Prisma (@prisma/adapter-mariadb)
DATABASE_URL="mysql://usuario:password@localhost:3306/focusly"

# Puerto donde levanta el servidor Express (opcional, por defecto 3000)
PORT=3000

# Secreto para firmar los JWT y su tiempo de expiracion (ej: "1d", "7d", "24h")
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Credenciales OAuth de Google Cloud Console, usadas para validar el login con Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""