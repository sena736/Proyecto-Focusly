# ======================================
# BASE DE DATOS (Prisma)
# ======================================
# Sin esta variable el servidor no arranca — Prisma la necesita para el adapter.
# Formato: mysql://usuario:password@host:puerto/nombre_db
DATABASE_URL=mysql://usuario:password@localhost:3306/focusly

# ======================================
# GOOGLE OAUTH (MOD-01 - Autenticación)
# ======================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======================================
# JWT (sesión propia del backend)
# ======================================
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ======================================
# SERVIDOR
# ======================================
PORT=3000